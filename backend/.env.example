MONGO_URI=mongodb://127.0.0.1:27017/bookmore
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_EXPIRES_IN=7d
PORT=5000
NODE_ENV=development

# Email — leave blank in development to use Ethereal auto-account (preview URLs logged)
# Set these for production SMTP delivery
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="BookMore" <noreply@bookmore.app>
